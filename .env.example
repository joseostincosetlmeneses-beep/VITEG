MONGODB_REPLICA_SET=
JWT_SECRET=replace-this-with-at-least-32-characters
CLIENT_ORIGIN=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

